#!/usr/bin/env bash
# Homebrew installs software, Mise installs runtimes, chezmoi manages files.
set -euo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
config="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.json"
export HOMEBREW_NO_AUTO_UPDATE=1
fail() { echo "dot: $*" >&2; exit 1; }
chez() { chezmoi --source "$repo/home" --config "$config" --destination "$HOME" "$@"; }
verbose=false
task() { printf '\n==> %s\n' "$*"; }
# Only for non-interactive commands. Keep stderr live and replay stdout on failure.
routine() (
  if "$verbose"; then "$@"; exit; fi
  local output result
  output="$(mktemp "${TMPDIR:-/tmp}/dot-output.XXXXXX")" || exit 1
  trap 'rm -f -- "$output"' EXIT
  if "$@" > "$output"; then exit 0; else result=$?; fi
  cat "$output" >&2
  exit "$result"
)
verify_rea() {
  local report result summary
  if "$verbose"; then "$@"; return; fi
  if report="$("$@")"; then return 0; else result=$?; fi
  if summary="$(jq -er '
    [.scope_checks[] | select(.ok == false) |
      "\(.name): \(.detail)" + (if (.remediation // "") != "" then "\n  \(.remediation)" else "" end)] |
    select(length > 0) | join("\n")
  ' <<< "$report" 2>/dev/null)"; then
    printf '%s\n' "$summary" >&2
  else
    printf 'REA with Ghidra verification failed (exit %s).\n' "$result" >&2
  fi
  printf 'Run ./dot init --verbose for the full REA report.\n' >&2
  return "$result"
}
config_summary() {
  local pending
  pending="$(chez status | awk 'substr($0, 2, 1) ~ /[ADMR]/ { count++ } END { print count+0 }')" || fail 'Cannot inspect pending configuration changes.'
  if [[ "$pending" == 0 ]]; then printf 'No pending configuration changes.\n'
  else printf '%s pending configuration changes. Run ./dot diff for details.\n' "$pending"; fi
}
check_directories() {
  local paths path
  paths="$(chez managed --include dirs --path-style absolute)" || fail 'Cannot inspect managed directories.'
  while IFS= read -r path; do
    [[ ! -L "$path" ]] || fail "Managed directory is a symlink: $path. Move the link aside before applying; keep its target data."
  done <<< "$paths"
}
rex_installed() {
  [[ "$(uname -s)" == Darwin ]] &&
    [[ -x /Applications/Rex.app/Contents/MacOS/Rex ||
       -x "$HOME/Applications/Rex.app/Contents/MacOS/Rex" ]]
}
rex_preference() {
  local key="$1" type="$2" expected="$3" current
  current="$(defaults read com.superlogical.rex "$key" 2>/dev/null)" || current=''
  if [[ "$type" == bool ]]; then
    case "$current" in 1) current=true ;; 0) current=false ;; esac
  fi
  [[ "$current" != "$expected" ]] || return 0
  if [[ "$mode" == check ]]; then
    printf 'Rex preference differs: %s. Run ./dot apply and relaunch Rex.\n' "$key"
    return 1
  fi
  defaults write com.superlogical.rex "$key" "-$type" "$expected" ||
    fail "Cannot set Rex preference $key."
  changed=true
}
rex_theme_ids() {
  if ! defaults read com.superlogical.rex Workspace.customThemes >/dev/null 2>&1; then
    echo '[]'
    return
  fi
  defaults export com.superlogical.rex - 2>/dev/null |
    plutil -extract 'Workspace\.customThemes' raw -expect data - 2>/dev/null |
    base64 -D 2>/dev/null |
    jq -ce '
      if type == "array" and all(.[]; (.name | type) == "string" and (.id | type) == "string")
      then map({name, id}) else error("unexpected theme data") end
    ' 2>/dev/null
}
rex_import_themes() (
  unset REX_BLOCK REX_SESSION REX_CLIENT
  local remote cli client theme
  local -a connection
  remote="$(defaults read com.superlogical.rex rex.client.remoteControl 2>/dev/null)" || return 1
  case "$remote" in 1|true|YES) ;; *) return 1 ;; esac
  if ! cli="$(command -v rex)"; then
    cli="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
  fi
  [[ -x "$cli" ]] || return 1
  # Target a single local Mac client, not the caller's Rex session or host.
  connection=(--autostart=false --server "unix://$HOME/Library/Application Support/rex/server.sock" --timeout 4s)
  client="$("$cli" "${connection[@]}" client ls --json 2>/dev/null |
    jq -er --argjson uid "$(id -u)" '
      [.clients[] | select(.connection_state == "connected" and
        .info.kind == "app" and .info.platform == "macos" and
        .principal.transport == "unix" and .principal.uid == $uid) | .client_id]
      | select(length == 1) | .[0] | strings | select(length > 0)
    ' 2>/dev/null)" || return 1
  for theme in "$@"; do
    "$cli" "${connection[@]}" --client "$client" do client.theme.import \
      "path=$HOME/.config/rex/themes/$theme" >/dev/null 2>&1 || return 1
    printf 'Requested Rex to import %s.\n' "$theme"
  done
)
rex_theme_id() {
  jq -er --arg theme "$2" '
    [.[] | select((.name | ascii_downcase) == ($theme | ascii_downcase)) | .id]
    | select(length == 1) | .[0] | strings | select(length > 0)
  ' <<< "$1" 2>/dev/null
}
rex_themes() {
  local ids theme id key ok=true
  local -a missing=()
  if ! ids="$(rex_theme_ids)"; then
    echo 'Rex theme list unreadable; leaving it alone.' >&2
    [[ "$mode" != check ]] && return 0
    return 1
  fi
  for theme in 'Catppuccin Mocha' 'Catppuccin Latte' 'Catppuccin Macchiato'; do
    if ! jq -e --arg theme "$theme" 'any(.[]; (.name | ascii_downcase) == ($theme | ascii_downcase))' <<< "$ids" >/dev/null; then
      missing+=("$theme")
    fi
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    if [[ "$mode" == apply ]]; then
      rex_import_themes "${missing[@]}" || :
      ids="$(rex_theme_ids)" || ids='[]'
    fi
    for theme in "${missing[@]}"; do
      if ! rex_theme_id "$ids" "$theme" >/dev/null; then
        printf 'Rex theme unavailable: %s. Import in Rex Settings, or retry with Rex open and Remote Control already enabled.\n' "$theme" >&2
        ok=false
      fi
    done
  fi
  for key in light dark; do
    case "$key" in light) theme='Catppuccin Latte' ;; dark) theme='Catppuccin Macchiato' ;; esac
    if id="$(rex_theme_id "$ids" "$theme")"; then
      rex_preference "Workspace.${key}ThemeID" string "$id" || ok=false
    else
      printf 'Rex needs one imported copy of %s to sync the %s theme selection.\n' "$theme" "$key" >&2
      ok=false
    fi
  done
  [[ "$mode" == apply ]] || "$ok"
}
rex_preferences() {
  local mode="$1" key type expected changed=false healthy=true
  rex_installed || return 0
  while read -r key type expected; do
    rex_preference "$key" "$type" "$expected" || healthy=false
  done <<'REX_PREFERENCES'
Workspace.activityGrouping string priority
Workspace.activityGroupingResetToPriority bool true
Workspace.appearance string system
Workspace.inactivePaneFadeMode string both
Workspace.interfaceStyle string useTheme
Workspace.paneDensity string comfortable
Workspace.playsProgramActivitySounds bool false
Workspace.sidebarCollapsed bool false
Workspace.sidebarPosition string left
Workspace.sidebarShowsActivity bool false
Workspace.tabBarEdge string top
Workspace.tabIconTintMode string off
Workspace.tabStyle string vertical
Workspace.terminalFontName string Geist Mono
Workspace.terminalFontPointSize float 14
Workspace.terminalFontStyle string Medium
Workspace.usesStandardInactiveWindowPaneStyles bool true
REX_PREFERENCES
  rex_themes || healthy=false
  if "$changed"; then echo 'Updated Rex preferences. Relaunch Rex to pick up the changes.'; fi
  "$healthy"
}
apply_config() {
  # Keep chezmoi on the terminal so it can ask about externally changed files.
  chez "$@" apply --verbose="$verbose"
  rex_preferences apply
}
skill_selections() {
  jq -r --arg profile "$selected" '
    .[] | select(.scope == "base" or .scope == $profile) | . as $entry |
    .skills[] | [$entry.source, ($entry.package // $entry.source), .] | @tsv
  ' "$repo/packages/skills.json"
}
check_skills() {
  local source="$1" name="$2" skills skill
  skills="$(jq -er --arg source "$source" --arg name "$name" '
    .skills | to_entries[] | select(.value.source == $source and ($name == "*" or .key == $name)) | .key
  ' "$HOME/.agents/.skill-lock.json")" || return 1
  while IFS= read -r skill; do
    [[ -f "$HOME/.agents/skills/$skill/SKILL.md" ]] || return 1
  done <<< "$skills"
}
profile() {
  selected="$(jq -r '.data.profile // empty' "$config")"
  case "$selected" in personal|work) ;; *) fail 'Run dot init --profile personal|work first.' ;; esac
}
usage() {
  echo 'dot init [--profile personal|work] [--upgrade] [--force] [--verbose]'
  echo 'dot apply [--force] [--verbose]'
  echo 'dot diff | status | doctor'
  echo 'dot package list [base|personal|work]'
}
# Find existing Homebrew even before the shell has been configured.
if ! command -v brew >/dev/null 2>&1; then
  for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [[ -x "$brew" ]]; then eval "$("$brew" shellenv)"; break; fi
  done
fi
command="${1:---help}"
[[ $# == 0 ]] || shift
case "$command" in
  --help|-h) usage ;;
  package)
    [[ "${1:-}" == list && $# -le 2 ]] || fail 'Use dot package list [base|personal|work].'
    groups=(base personal work)
    if [[ $# == 2 ]]; then
      case "$2" in base|personal|work) groups=("$2") ;; *) fail 'Unknown package group.' ;; esac
    fi
    for group in "${groups[@]}"; do
      printf '\n[%s]\n' "$group"
      while IFS= read -r line; do printf '%s\n' "$line"; done < "$repo/packages/Brewfile.$group"
    done ;;
  init)
    requested=''; upgrade=false; force=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --profile)
          [[ $# -ge 2 ]] || fail '--profile needs personal or work.'
          requested="$2"; shift
          case "$requested" in personal|work) ;; *) fail 'Unknown profile.' ;; esac ;;
        --upgrade) upgrade=true ;;
        --force) force=(--force) ;;
        --verbose|-v) verbose=true ;;
        --help|-h) usage; exit 0 ;;
        *) fail "Unknown option: $1" ;;
      esac
      shift
    done
    [[ "$(uname -s)" == Darwin ]] || fail 'Setup requires macOS.'
    task 'Check setup prerequisites'
    if ! command -v brew >/dev/null 2>&1; then
      installer="$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
      /bin/bash -c "$installer"
      for brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [[ -x "$brew" ]]; then eval "$("$brew" shellenv)"; break; fi
      done
    fi
    for tool in chezmoi mise jq; do
      command -v "$tool" >/dev/null 2>&1 || brew install "$tool"
    done
    if [[ -f "$config" ]]; then
      profile
      [[ -z "$requested" || "$requested" == "$selected" ]] || fail 'Profile switching needs a reviewed migration; nothing is removed automatically.'
    else
      if [[ -n "$requested" ]]; then chez init --promptChoice "Profile=$requested"; else chez init; fi
      profile
    fi
    skills="$(skill_selections)" || fail 'Cannot read packages/skills.json.'
    printf 'Profile: %s\n' "$selected"
    task 'Review pending configuration'
    check_directories
    if "$verbose"; then chez diff; else config_summary; fi
    task 'Prepare Homebrew tap'
    brew tap anomalyco/tap
    brew trust --formula anomalyco/tap/opencode-v2
    brew_options=()
    if ! "$upgrade"; then brew_options+=(--no-upgrade); fi
    if ! "$verbose"; then brew_options+=(--quiet); fi
    for group in base "$selected"; do
      task "Install Homebrew packages ($group)"
      brew bundle install ${brew_options[@]+"${brew_options[@]}"} --file "$repo/packages/Brewfile.$group"
    done
    task 'Apply configuration'
    apply_config ${force[@]+"${force[@]}"}
    task 'Install Mise runtimes'
    routine mise --cd "$HOME" --yes install
    task 'Install agent skills'
    while IFS=$'\t' read -r source package skill; do
      [[ -n "$source" ]] || continue
      routine mise --cd "$HOME" exec -- npx --yes skills add "$package" --global --agent pi --skill "$skill" --yes
    done <<< "$skills"
    task 'Check Cua driver and skill'
    cua="$HOME/.local/bin/cua-driver"
    if [[ ! -x "$cua" ]]; then
      [[ ! -e "$cua" && ! -L "$cua" ]] || fail "Refusing to replace $cua."
      installer="$(curl -fsSL https://cua.ai/driver/install.sh)"
      /bin/bash -c "$installer" cua-driver-install --bin-dir "$HOME/.local/bin" --no-modify-path
    fi
    routine "$cua" --version
    if [[ ! -f "$HOME/.agents/skills/cua-driver/SKILL.md" ]]; then "$cua" skills install; fi
    [[ -f "$HOME/.agents/skills/cua-driver/SKILL.md" ]] || fail 'Cua skill is missing; check existing skill links.'
    task 'Check Pi packages'
    while IFS= read -r package; do
      name="${package#npm:}"
      manifest="$HOME/.pi/agent/npm/node_modules/$name/package.json"
      if [[ ! -f "$manifest" ]] || ! jq -e --arg name "$name" '.name == $name' "$manifest" >/dev/null; then
        mise --cd "$HOME" exec -- pi install "$package"
      fi
    done < <(jq -r '.packages[]' "$HOME/.pi/agent/settings.json")
    task 'Set up Worktrunk shell integration and Pi plugin'
    # Keep the vendor installers on the terminal for confirmation.
    wt config shell install
    wt config plugins pi install
    if [[ "$selected" == personal ]]; then
      task 'Verify REA with Ghidra'
      rea="$(jq -r '.mcpServers.rea.args[] | select(startswith("rea-agents@"))' "$HOME/.pi/agent/mcp.json")"
      [[ "$rea" =~ ^rea-agents@[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail 'REA must use a pinned release.'
      GHIDRA_INSTALL_DIR="$(jq -r '.mcpServers.rea.env.GHIDRA_INSTALL_DIR' "$HOME/.pi/agent/mcp.json")" \
        REA_ANALYSIS_PROVIDER=ghidra verify_rea mise --cd "$HOME" exec -- npx --yes "$rea" doctor --provider ghidra --json
    fi
    task 'Build bat theme cache'
    routine bat cache --build
    printf '\nDone. Sign-ins, licences, and macOS permissions remain interactive.\n' ;;
  diff|status|apply)
    command -v chezmoi >/dev/null 2>&1 || fail 'Run dot init first.'
    [[ -f "$config" ]] || fail 'Run dot init --profile personal|work first.'
    profile
    if [[ "$command" != apply ]]; then
      [[ $# == 0 ]] || fail "dot $command takes no options."
      chez "$command"
    else
      force=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --force) force=(--force) ;;
          --verbose|-v) verbose=true ;;
          --help|-h) usage; exit 0 ;;
          *) fail "Unknown option: $1" ;;
        esac
        shift
      done
      task "Apply configuration ($selected)"
      check_directories
      if ! "$verbose"; then config_summary; fi
      apply_config ${force[@]+"${force[@]}"}
      printf '\nDone.\n'
    fi ;;
  doctor)
    [[ $# == 0 ]] || fail 'doctor takes no options.'
    profile
    healthy=true
    chez verify || healthy=false
    rex_preferences check || healthy=false
    for group in base "$selected"; do
      brew bundle check --no-upgrade --file "$repo/packages/Brewfile.$group" || healthy=false
    done
    mise --cd "$HOME" doctor || healthy=false
    skills="$(skill_selections)" || fail 'Cannot read packages/skills.json.'
    while IFS=$'\t' read -r source package skill; do
      [[ -n "$source" ]] || continue
      check_skills "$source" "$skill" || { echo "Missing skill or installer record: $source ($skill). Run dot init."; healthy=false; }
    done <<< "$skills"
    [[ -x "$HOME/.local/bin/cua-driver" && -f "$HOME/.agents/skills/cua-driver/SKILL.md" ]] || { echo 'Missing Cua CLI or skill.'; healthy=false; }
    if [[ "$selected" == personal ]]; then
      ghidra="$(jq -r '.mcpServers.rea.env.GHIDRA_INSTALL_DIR // empty' "$HOME/.pi/agent/mcp.json")" || healthy=false
      native=mac_x86_64
      [[ "$(uname -m)" != arm64 ]] || native=mac_arm_64
      if [[ ! -x "$ghidra/support/analyzeHeadless" || ! -f "$ghidra/Ghidra/application.properties" ]] ||
        [[ ! -x "$ghidra/Ghidra/Features/Decompiler/os/$native/decompile" && ! -x "$ghidra/Ghidra/Features/Decompiler/build/os/$native/decompile" ]]; then
        echo 'Missing Ghidra headless installation or host-native decompiler. Run dot init.'
        healthy=false
      fi
      MISE_AUTO_INSTALL=0 MISE_EXEC_AUTO_INSTALL=0 mise --cd "$HOME" exec -- java -version || healthy=false
    fi
    if [[ "$selected" == work ]]; then
      for path in "$HOME/.agents/skills/reverse-engineer-anything" "$HOME"/.npm/_npx/*/node_modules/rea-agents; do
        if [[ -e "$path" || -L "$path" ]]; then echo "Personal leftover (not removed): $path"; healthy=false; fi
      done
    fi
    echo "Profile: $selected. Account authentication was not checked."
    "$healthy" ;;
  *) usage >&2; exit 2 ;;
esac
