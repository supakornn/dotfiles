[alias]
  cl = clone
  recent = for-each-ref --sort=committerdate refs/heads/ --format='%(HEAD) %(refname:short) - %(contents:subject) - %(authorname) (%(committerdate:relative))'

[color]
  ui = true

[core]
  autocrlf = input
  excludesfile = ~/.gitignore_global
  ignorecase = false
  safecrlf = warn
  abbrev = 7
  editor = nvim

[fetch]
  prune = true

[init]
  defaultBranch = main

[merge]
  conflictstyle = zdiff3

[push]
  default = simple

[pull]
  rebase = false

# Keep your name and email in ~/.gitconfig.local, which is never tracked.
[include]
  path = ~/.gitconfig.local
