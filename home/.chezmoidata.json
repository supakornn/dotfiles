{
  "piSettings": {
    "theme": "catppuccin-mocha",
    "packages": [
      "npm:pi-web-access",
      "npm:pi-toggle-skills",
      "npm:@plannotator/pi-extension",
      "npm:pi-context-view",
      "npm:@ff-labs/pi-fff"
    ],
    "skills": [
      "~/.agents/skills",
      "skills-local"
    ],
    "defaultProjectTrust": "ask"
  },
  "personalPiDefaults": {
    "defaultProvider": "openai",
    "defaultModel": "gpt-6.1-sol"
  },
  "mcpServers": {
    "alphaxiv": {
      "url": "https://api.alphaxiv.org/mcp/v1"
    },
    "huggingface": {
      "url": "https://huggingface.co/mcp",
      "description": "Search Hugging Face models, datasets, papers, and documentation."
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "!echo Bearer $(gh auth token)"
      },
      "description": "Work with GitHub repositories, issues, pull requests, and code."
    },
    "rea": {
      "type": "stdio",
      "command": "mise",
      "args": [
        "exec",
        "--",
        "npx",
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ],
      "env": {
        "REA_ANALYSIS_PROVIDER": "ghidra",
        "MISE_AUTO_INSTALL": "0",
        "MISE_EXEC_AUTO_INSTALL": "0"
      }
    },
    "cua-driver": {
      "command": "~/.local/bin/cua-driver",
      "args": [
        "mcp"
      ],
      "description": "Control macOS apps and browsers through Cua Driver"
    }
  }
}
