### --- Tmux Configuration ---

set-option -sa terminal-overrides ",xterm*:Tc"

set -g status-position bottom

# Set tmux prefix to Ctrl+B and Ctrl+A
set -g prefix C-b
set -g prefix2 C-a

# Enable mouse mode
set -g mouse on

# Enable vi-mode
setw -g mode-keys vi

# Modern terminal settings
set -g default-terminal "screen-256color"

# Set fish as default shell
set -g default-shell /opt/homebrew/bin/fish

# Performance and UX improvements
set -sg escape-time 0
set -g history-limit 50000
set -g display-time 4000
set -g status-interval 5
set -g status-keys vi
set -g focus-events on  # Modern terminals support this
set -g set-clipboard on

# Activity monitoring
setw -g monitor-activity off
set -g visual-activity on

# Status bar styling
set -g status-style bg=default

# -- Plugin Settings --
set -g @tmux-fzf-launch-key "C-f"
set -g @tmux-fzf-options "-p -w 62% -h 38% -m"

### --- Plugins ---

# Plugin Manager
set -g @plugin 'tmux-plugins/tpm'

# Plugins
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'tmux-plugins/tmux-battery'
set -g @plugin 'catppuccin/tmux'

# Catppuccin settings
set -g @catppuccin_flavor "macchiato"
set -g @catppuccin_window_status_style "rounded"

### --- Keybinds ---

# Vim-style pane navigation
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# Alt (Meta) key pane navigation
bind -n M-h select-pane -L
bind -n M-j select-pane -D
bind -n M-k select-pane -U
bind -n M-l select-pane -R

# Reload config
bind r source-file ~/.tmux.conf \; display "Config reloaded!"

# Session navigation
bind -r ( switch-client -p
bind -r ) switch-client -n

# Copy mode improvements
bind-key -T copy-mode-vi v send -X begin-selection
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle

# Paste improvements
bind ] run "pbpaste | tmux load-buffer - && tmux paste-buffer"
bind v paste-buffer

# Modern split pane bindings
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# Window management
bind c new-window -c "#{pane_current_path}"
bind C-p previous-window
bind C-n next-window

# Clear screen
bind '=' send-keys -R \; send-keys C-l \; clear-history

# Window and pane index settings
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on

# Status line configuration
set -g status-right-length 100
set -g status-left-length 100
set -g status-left ""
set -g status-right "#{E:@catppuccin_status_application}"
set -agF status-right "#{E:@catppuccin_status_cpu}"
set -ag status-right "#{E:@catppuccin_status_session}"
set -ag status-right "#{E:@catppuccin_status_uptime}"
set -agF status-right "#{E:@catppuccin_status_battery}"

# Initialize tmux plugin manager (keep this line at the very bottom)
run '~/.tmux/plugins/tpm/tpm'
