#!/usr/bin/env bash
# Switch the dotfiles UI palette without modifying the Stow-managed sources.
set -euo pipefail

state_dir="$HOME/.config/dotfiles"
state_file="$state_dir/theme"
usage() {
  echo "usage: theme {light|dark|auto}" >&2
  exit 2
}

case "${1:-}" in
  light) flavor=latte ;;
  dark) flavor=macchiato ;;
  auto)
    if defaults read -g AppleInterfaceStyle 2>/dev/null | grep -qx 'Dark'; then
      flavor=macchiato
    else
      flavor=latte
    fi
    ;;
  *) usage ;;
esac

mkdir -p "$state_dir" "$HOME/.cache/dotfiles"
printf '%s\n' "$flavor" >"$state_file"

# Starship has no palette selector at runtime, so keep its generated copy local.
if [[ -f "$HOME/.config/starship.toml" ]]; then
  sed "s/^palette = .*/palette = \"catppuccin_$flavor\"/" \
    "$HOME/.config/starship.toml" >"$HOME/.cache/dotfiles/starship.toml"
fi

# These files are deliberately local runtime configs (see install.sh).
if [[ -f "$HOME/.config/btop/btop.conf" && ! -L "$HOME/.config/btop/btop.conf" ]]; then
  sed -i '' "s/^color_theme = .*/color_theme = \"catppuccin_$flavor\"/" \
    "$HOME/.config/btop/btop.conf"
fi

if [[ -f "$HOME/.tmux.conf" ]] && command -v tmux >/dev/null && tmux has-session 2>/dev/null; then
  tmux source-file "$HOME/.tmux.conf"
fi

if [[ "$flavor" == latte ]]; then name=Latte; else name=Macchiato; fi
echo "Catppuccin $name selected. Restart Neovim, btop, and LazyGit if open."
