.DS_Store
.dotfiles/
__pycache__/
*.pyc
Brewfile.lock.json

# Agent working notes are local, not part of the dotfiles configuration.
/tasks/

# Never capture runtime state or credentials into chezmoi's source tree.
home/private_dot_agents/*skill-lock.json*
home/private_dot_agents/skills/*cua-driver*
home/*dot_cua-driver*/
home/dot_config/fish/*fish_variables*
home/dot_config/nvim/lazy-lock.json
home/dot_config/nvim/dot_pi/
home/dot_config/nvim/private_dot_pi/
home/private_dot_pi/agent/*auth.json*
home/private_dot_pi/agent/*trust.json*
home/private_dot_pi/agent/*sessions*/
home/dot_config/herdr/*plugins*
home/dot_config/herdr/*session*

# Herdr desktop: only the settings modifier and custom appearance are sources.
home/dot_config/herdr-app/*
!home/dot_config/herdr-app/modify_settings.json
!home/dot_config/herdr-app/layouts/
!home/dot_config/herdr-app/themes/
!home/dot_config/herdr-app/mods/
home/dot_config/herdr-app/layouts/*
!home/dot_config/herdr-app/layouts/catppuccin.json
!home/dot_config/herdr-app/layouts/catppuccin.png
home/dot_config/herdr-app/themes/*
!home/dot_config/herdr-app/themes/catppuccin-mocha.json
home/dot_config/herdr-app/mods/*
!home/dot_config/herdr-app/mods/spaces-icons/
!home/dot_config/herdr-app/mods/tabs-graph/
home/dot_config/herdr-app/mods/*/jsconfig.json
home/dot_config/herdr-app/mods/*/*.d.ts
home/dot_config/herdr-app/mods/*/*.error
